{
  "name": "quick-mirror",
  "version": "1.1.5",
  "description": "Quick Mirror - System tray webcam mirror for Windows (Hand Mirror style)",
  "main": "main.js",
  "author": "Dhruv Chaturvedi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dhruvcx-1/webcamquickmirror.git"
  },
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:portable": "electron-builder --win portable -c.win.artifactName=\"Quick Mirror ${version}.${ext}\" --publish never",
    "build:installer": "electron-builder --win nsis -c.win.artifactName=\"Quick Mirror Setup ${version}.${ext}\" --publish never"
  },
  "dependencies": {
    "electron-log": "^5.1.1",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.1.7"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.quickmirror.app",
    "productName": "Quick Mirror",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "store.js",
      "logger.js",
      "windowFactory.js",
      "autoUpdater.js",
      "toast.js",
      "renderer.js",
      "fullscreen-renderer.js",
      "cameraManager.js",
      "settingsManager.js",
      "index.html",
      "fullscreen.html",
      "fullscreen.css",
      "settings.html",
      "settings.js",
      "settings.css",
      "about.html",
      "about.js",
      "about.css",
      "styles.css",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/tray-icon.png",
      "artifactName": "${productName} ${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Quick Mirror",
      "runAfterFinish": false,
      "license": null,
      "differentialPackage": true,
      "include": "installer.nsh"
    },
    "publish": {
      "provider": "github",
      "owner": "dhruvcx-1",
      "repo": "webcamquickmirror"
    }
  }
}
